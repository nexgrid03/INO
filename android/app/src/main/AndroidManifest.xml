<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access for Supabase auth / Google Sign-In (release builds must
         not rely on this being merged in from a plugin manifest). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Biometric app-lock (fingerprint / Face unlock). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Reminder push notifications (FCM). Android 13+ (API 33) requires this
         as a RUNTIME permission - PushService.init() prompts for it. Without
         the prompt being granted, messages are delivered to the app but the
         system never shows them, which looks exactly like "push is broken". -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice navigation: on-device speech recognition needs the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Scanner: camera + gallery import permissions. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:label="inoapp"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Preload the ML Kit modules from Google Play services: the document
             scanner and the OCR (text-recognition) model, so both are ready on
             first use instead of downloading on demand. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="docscanner,ocr" />

        <!-- ================= Reminder push notifications (FCM) ================= -->
        <!-- The channel a BACKGROUND message lands in when the system builds the
             notification itself (the app isn't running, so no Dart code picks a
             channel). Must match the id PushService creates via
             flutter_local_notifications, or Android 8+ drops the message with
             "no such channel". -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ino_reminders" />
        <!-- Monochrome status-bar icon. Android tints this by the accent colour;
             a full-colour icon renders as a white square. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ino_notification_accent" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- ============ Secure Document Sharing - deep links ============ -->
            <!-- Android App Links: a scanned share URL opens INO directly.
                 android:autoVerify triggers domain verification against
                 https://<host>/.well-known/assetlinks.json (see DEEP_LINKING.md).
                 When INO is NOT installed, the same https link opens in the
                 browser as normal - nothing else is needed for that fallback. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="ilfzppryyojoponkomrw.functions.supabase.co"
                    android:pathPrefix="/share/" />
            </intent-filter>

            <!-- Optional custom domain (uncomment + set your host once you route
                 it to the Edge Function and host assetlinks.json there):
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ino.app"
                      android:pathPrefix="/share/" />
            </intent-filter>
            -->

            <!-- Custom-scheme fallback - ALWAYS opens the app (no domain
                 verification needed). Used for testing and any non-web trigger:
                 ino://share/<share_id> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ino" android:host="share" />
            </intent-filter>

            <!-- View Once (one-time links). The https App Link above already
                 covers /share/v/<token> via its /share/ prefix; this is the
                 custom-scheme fallback: ino://viewonce/<token>.

                 A one-time link is routed to the GATED viewer, which warns the
                 recipient before spending their single view - so merely opening
                 the app from this intent never burns the share. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ino" android:host="viewonce" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Voice navigation (speech_to_text): required on Android 11+ so the app
             can discover the on-device speech recognition service. Without this,
             speech recognition silently returns no results. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Scanned payment QRs: required on Android 11+ so the app can DISCOVER
             which UPI apps (Google Pay, PhonePe, Paytm, BHIM, …) are installed
             and offer them in the payment picker. Without this, package
             visibility hides them all and the picker silently comes up empty.

             BOTH forms are needed. UPI apps declare their filter as
             `scheme="upi" host="pay"`, and a queries entry carrying only the
             scheme describes the URI `upi://` - which does NOT match a filter
             that requires a host, so the query returns nothing. The
             scheme+host entry is the one that actually matches; the
             scheme-only entry is kept for apps that register the scheme
             without a host. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" android:host="pay" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>
</manifest>
