# The Supabase `share` Edge Function base URL. The frontend talks to this
# server-side only (never exposed to the browser). Set this in Vercel →
# Project → Settings → Environment Variables.
SUPABASE_FUNCTIONS_URL=https://ilfzppryyojoponkomrw.functions.supabase.co

# Pre-shared secret between share-frontend (Vercel) and the Supabase share Edge Function.
# Generates authenticated x-ino-proxy-token header to safely forward visitor IP.
# Must match the SHARE_PROXY_SECRET configured in Supabase secrets.
# Required for proxy IP forwarding; fails closed if unset.
SHARE_PROXY_SECRET=

# Supabase project URL and anon / publishable key for server-side auth operations (e.g. self-service account deletion).
# Required for account deletion endpoints; fails closed if unset.
SUPABASE_URL=https://ilfzppryyojoponkomrw.supabase.co
SUPABASE_ANON_KEY=

